# Server
PORT=desired port
REALTIME_DATA_CRON=time interval to fetch realtime data

# Postgres database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_passwd
POSTGRES_DATABASE=db_name

# Sentry
SENTRY_DSN=
PRODUCTION=false

# Disable endpoints
DISABLE_SERVICE_STATIONS=false
DISABLE_SERVICE_STATIONS_HISTORIC=false
DISABLE_MUNICIPALITIES=false

# Historic data
# Maximum date range for historic prices queries.
# Format: XyXm (e.g., "4y6m" = 4 years and 6 months), "Xy", or "Xm".
# Minimum: 6 months. Leave empty for no limit.
HISTORIC_DATA_MAX_RANGE=

# MCP
ENABLE_MCP=true
# MCP Security (DNS rebinding protection)
# Comma-separated list of allowed origins. Use * to allow all (development only).
# Leave empty to allow everything
# Example: https://your-app.com,https://another-app.com
MCP_ALLOWED_ORIGINS=
# Comma-separated list of allowed host headers.
# Leave empty to allow everything
# Example: localhost,127.0.0.1,your-domain.com
MCP_ALLOWED_HOSTS=