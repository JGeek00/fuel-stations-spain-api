{
  "name": "fuel-stations-spain-api",
  "version": "1.12.7",
  "description": "REST API that provides realtime information about fuel prices in Spain",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGeek00/fuel-stations-spain-api.git"
  },
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build:dev": "pnpm run typecheck && ttsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "ttsc --noEmit",
    "bump-version:major": "node scripts/bump-version.js major",
    "bump-version:major:beta": "node scripts/bump-version.js major beta",
    "bump-version:minor": "node scripts/bump-version.js minor",
    "bump-version:minor:beta": "node scripts/bump-version.js minor beta",
    "bump-version:bugfix": "node scripts/bump-version.js bugfix",
    "bump-version:bugfix:beta": "node scripts/bump-version.js bugfix beta",
    "bump-version:beta": "node scripts/bump-version.js beta",
    "build:prod": "pnpm run build:prod:compile && pnpm run build:prod:obfuscate",
    "build:prod:compile": "ttsc -p tsconfig.build.json --sourceMap false --declaration false --declarationMap false && tsc-alias -p tsconfig.build.json",
    "build:prod:obfuscate": "node scripts/obfuscate.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mcp:info": "echo 'MCP server available at http://localhost:${PORT:-3000}/mcp when the API is running'",
    "generate:mcp-docs": "node scripts/generate-mcp-docs.js"
  },
  "author": "JGeek00",
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/morgan": "1.9.10",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "javascript-obfuscator": "5.10.1",
    "nodemon": "3.1.14",
    "tsc-alias": "1.9.10",
    "tsconfig-paths": "4.2.0",
    "ttsc": "0.37.0",
    "typescript": "~7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sentry/node": "11.12.0",
    "@sentry/profiling-node": "11.12.0",
    "better-sqlite3": "13.1.1",
    "cors": "2.8.6",
    "cron": "4.4.0",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "morgan": "1.12.1",
    "pg": "8.23.1",
    "sequelize": "6.37.8",
    "sqlite3": "6.0.1",
    "typia": "15.4.0",
    "zod": "4.6.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
